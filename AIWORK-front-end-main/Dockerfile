FROM node:20-alpine

# Cài đặt dependencies cơ bản
RUN apk add --no-cache \
    build-base \
    cairo-dev \
    pango-dev \
    jpeg-dev \
    giflib-dev \
    pixman-dev

# Đặt thư mục làm việc
WORKDIR /app

# Copy và cài đặt dependencies
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

# Copy toàn bộ mã nguồn
COPY . .

# Accept build arguments
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_DEFAULT_LANGUAGE
ARG NEXT_PUBLIC_FILE_RESOURCE_URL
ARG NEXT_HOST_URL
ARG NEXT_PUBLIC_MIXPANEL_TOKEN
ARG NEXT_PUBLIC_AI_SERVICE_API_KEY
ARG NEXT_PUBLIC_AI_SERVICE_URL
ARG NEXT_PUBLIC_AI_SERVICE_URL
ARG NEXT_PUBLIC_AI_SERVICE_API_KEY
ARG NEXT_PUBLIC_STACK_PROJECT_ID
ARG NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY
ARG STACK_SECRET_SERVER_KEY
ARG DEEPGRAM_API_KEY

# Set environment variables during build
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_DEFAULT_LANGUAGE=$NEXT_PUBLIC_DEFAULT_LANGUAGE
ENV NEXT_PUBLIC_FILE_RESOURCE_URL=$NEXT_PUBLIC_FILE_RESOURCE_URL
ENV NEXT_HOST_URL=$NEXT_HOST_URL
ENV NEXT_PUBLIC_MIXPANEL_TOKEN=$NEXT_PUBLIC_MIXPANEL_TOKEN
ENV NEXT_PUBLIC_AI_SERVICE_API_KEY=$NEXT_PUBLIC_AI_SERVICE_API_KEY
ENV NEXT_PUBLIC_AI_SERVICE_URL=$NEXT_PUBLIC_AI_SERVICE_URL
ENV NEXT_PUBLIC_AI_SERVICE_URL=$NEXT_PUBLIC_AI_SERVICE_URL
ENV NEXT_PUBLIC_AI_SERVICE_API_KEY=$NEXT_PUBLIC_AI_SERVICE_API_KEY
ENV NEXT_PUBLIC_STACK_PROJECT_ID=$NEXT_PUBLIC_STACK_PROJECT_ID
ENV NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=$NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY
ENV STACK_SECRET_SERVER_KEY=$STACK_SECRET_SERVER_KEY
ENV DEEPGRAM_API_KEY=$DEEPGRAM_API_KEY

# Bỏ qua kiểm tra TypeScript
ENV NEXT_IGNORE_TYPECHECK=true
ENV DISABLE_TYPE_CHECKS=true
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Set environment variables from build args
# ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-http://192.168.100.123:8000}
# ENV NEXT_PUBLIC_DEFAULT_LANGUAGE=${NEXT_PUBLIC_DEFAULT_LANGUAGE:-en}
# ENV NEXT_PUBLIC_FILE_RESOURCE_URL=${NEXT_PUBLIC_FILE_RESOURCE_URL:-https://thk-api.vfmtech.vn}

# Debug: Print environment variables
RUN echo "Building with API_BASE_URL: $NEXT_PUBLIC_API_BASE_URL"
RUN echo "Building with DEFAULT_LANGUAGE: $NEXT_PUBLIC_DEFAULT_LANGUAGE"

# Build ứng dụng Next.js
RUN npm run build

# Copy static files để đảm bảo các chunk được serve đúng cách
RUN cp -r .next/static .next/standalone/.next/
RUN cp -r public .next/standalone/

# Mở port
EXPOSE 3000

# Khởi động ứng dụng với standalone mode
CMD ["node", ".next/standalone/server.js"]