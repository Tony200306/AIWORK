# Deployment Environment: PROD or DEV
# - PROD: uses vantum_db_prod database, queues with _prod suffix
# - DEV: uses vantum_db_dev database, queues without suffix
ENV_DEPLOYMENT=DEV

PORT=8000
SWAGGER_ENDPOINT='docs'

# Database
# PROD: postgresql://user:pass@host:port/vantum_db_prod
# DEV:  postgresql://user:pass@host:port/vantum_db_dev
DATABASE_URL=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=1d

# RabbitMQ Configuration
# Queue names automatically get _prod suffix when ENV_DEPLOYMENT=PROD
RABBITMQ_ENABLED=true
RABBITMQ_URL=
RABBITMQ_EXCHANGE=app.events

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Storage Configuration (MinIO/S3)
STORAGE_ENABLED=true
STORAGE_ENDPOINT=
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=vantum-files
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# Beehiiv Newsletter Configuration
BEEHIIV_ENABLED=false
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_BASE_URL=https://api.beehiiv.com/v2

# AI Priority Service Configuration
AI_PRIORITY_ENABLED=true
AI_PRIORITY_SERVICE_URL=http://localhost:8042
AI_PRIORITY_API_KEY=
AI_PRIORITY_TIMEOUT=30000
