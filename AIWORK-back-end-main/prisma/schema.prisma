// Execution tracking

model TaskRun {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  taskId             String             @map("task_id") @db.Uuid
  sprintId           String?            @map("sprint_id") @db.Uuid
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?          @map("ended_at") @db.Timestamptz(6)
  status             TaskRunStatus
  pausedTotalSeconds Int?               @map("paused_total_seconds")
  activeStepId       String?            @map("active_step_id") @db.Uuid
  startedFrom        TaskRunStartedFrom @map("started_from")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  activeStep Step? @relation("ActiveStep", fields: [activeStepId], references: [id], onDelete: SetNull)

  stepRuns      StepRun[]
  completionLog TaskCompletionLog?

  // NEW: Link to unified ScheduleEvent
  // scheduleEvent ScheduleEvent?

  @@index([userId])
  @@index([taskId])
  @@index([sprintId])
  @@map("task_run")
}

model StepRun {
  id          String        @id @default(uuid()) @db.Uuid
  taskRunId   String        @map("task_run_id") @db.Uuid
  stepId      String        @map("step_id") @db.Uuid
  status      StepRunStatus
  scheduledAt DateTime?     @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime?     @map("ended_at") @db.Timestamptz(6)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  taskRun TaskRun @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  step    Step    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  // NEW: Link to unified ScheduleEvent
  scheduleEvent ScheduleEvent?

  @@index([taskRunId])
  @@index([stepId])
  @@map("step_run")
}

model TaskCompletionLog {
  id                     String   @id @default(uuid()) @db.Uuid
  taskRunId              String   @unique @map("task_run_id") @db.Uuid
  taskId                 String   @map("task_id") @db.Uuid
  plannedMinutesSnapshot Float?     @map("planned_minutes_snapshot")
  actualMinutes          Int?     @map("actual_minutes")
  difficultyRating       Int?     @map("difficulty_rating")
  shipSummary            String?  @map("ship_summary") @db.Text
  slowdownNotes          String?  @map("slowdown_notes") @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taskRun TaskRun @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_completion_log")
}

// Plan change proposals

model PlanChangeProposal {
  id                  String    @id @default(uuid()) @db.Uuid
  taskId              String    @map("task_id") @db.Uuid
  fromPlanVersionId   String    @map("from_plan_version_id") @db.Uuid
  toPlanVersionId     String    @map("to_plan_version_id") @db.Uuid
  deltaPlannedMinutes Float       @map("delta_planned_minutes")
  deltaStepsCount     Int       @map("delta_steps_count")
  reason              String    @db.Text
  status              String    @db.Text
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id])

  fromPlanVersion TaskPlanVersion @relation("PlanChangeFrom", fields: [fromPlanVersionId], references: [id])
  toPlanVersion   TaskPlanVersion @relation("PlanChangeTo", fields: [toPlanVersionId], references: [id])

  @@map("plan_change_proposal")
}

// Blocker links

model BlockerLink {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  blockerTaskId String    @map("blocker_task_id") @db.Uuid
  blockedTaskId String?   @map("blocked_task_id") @db.Uuid
  blockedStepId String?   @map("blocked_step_id") @db.Uuid
  status        String    @db.Text
  severity      Int
  confidence    Float
  discoveredAt  DateTime  @map("discovered_at") @db.Timestamptz(6)
  clearedAt     DateTime? @map("cleared_at") @db.Timestamptz(6)
  notes         String?   @db.Text

  user User @relation(fields: [userId], references: [id])

  blockerTask Task  @relation("BlockerTask", fields: [blockerTaskId], references: [id])
  blockedTask Task? @relation("BlockedTask", fields: [blockedTaskId], references: [id])
  blockedStep Step? @relation("BlockedStep", fields: [blockedStepId], references: [id])

  // Goal-related (commented out for now)
  // blockedGoalId String? @map("blocked_goal_id") @db.Uuid
  // blockedGoal   Goal?   @relation("BlockedGoal", fields: [blockedGoalId], references: [id])

  @@map("blocker_link")
}

// Guidance sessions

model GuidanceSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  type                 String    @db.Text
  timerSeconds         Float       @map("timer_seconds")
  startedAt            DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime? @map("ended_at") @db.Timestamptz(6)
  status               String    @db.Text
  inputDumpText        String?   @map("input_dump_text") @db.Text
  resultPlanVersionId  String?   @map("result_plan_version_id") @db.Uuid
  capacityDeltaMinutes Float       @map("capacity_delta_minutes")
  decision             String    @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  resultPlanVersion TaskPlanVersion? @relation("GuidanceSessionResultPlan", fields: [resultPlanVersionId], references: [id])

  guidanceSessionAssets GuidanceSessionAsset[]

  @@map("guidance_session")
}

// Asset relations

model TaskAsset {
  taskId    String   @map("task_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  context   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task  Task  @relation(fields: [taskId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@id([taskId, assetId, context])
  @@map("task_asset")
}

model StepAsset {
  stepId    String   @map("step_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  context   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  step  Step  @relation(fields: [stepId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@id([stepId, assetId, context])
  @@map("step_asset")
}

model GuidanceSessionAsset {
  guidanceSessionId String   @map("guidance_session_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  context           String   @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  guidanceSession GuidanceSession @relation(fields: [guidanceSessionId], references: [id])
  asset           Asset           @relation(fields: [assetId], references: [id])

  @@id([guidanceSessionId, assetId, context])
  @@map("guidance_session_asset")
}

// ============================================================================
// UNIFIED SCHEDULE EVENTS (with internal source references)
// ============================================================================

model ScheduleEvent {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  source                ScheduleEventSource
  externalProvider      ScheduleEventProvider @map("external_provider")
  externalEventId       String?               @map("external_event_id") @db.Text
  calendarId            String?               @map("calendar_id") @db.Text
  title                 String?               @db.Text
  description           String?               @db.Text
  startAt               DateTime              @map("start_at") @db.Timestamptz(6)
  endAt                 DateTime              @map("end_at") @db.Timestamptz(6)
  timezone              String?               @db.Text
  isAllDay              Boolean               @default(false) @map("is_all_day")
  status                ScheduleEventStatus
  lastProviderUpdatedAt DateTime?             @map("last_provider_updated_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  energy ScheduleEventEnergy?

  // ============================================================================
  // NEW: Internal source references (nullable - only one should be set)
  // ============================================================================

  // Link to BlockInstance (when source = BLOCK_TEMPLATE)
  blockInstanceId String?        @unique @map("block_instance_id") @db.Uuid
  blockInstance   BlockInstance? @relation(fields: [blockInstanceId], references: [id], onDelete: Cascade)

  // // Link to TaskRun (when source = TASK_SESSION)
  // taskRunId String?  @unique @map("task_run_id") @db.Uuid
  // taskRun   TaskRun? @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  // Link to StepRun (when source = STEP_SESSION)
  stepRunId String?  @unique @map("step_run_id") @db.Uuid
  stepRun   StepRun? @relation(fields: [stepRunId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@index([startAt, endAt])
  @@map("schedule_event")
}

model EnergyActivityCatalogue {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.Text
  category            String   @db.Text
  defaultEnergyPoints Int      @map("default_energy_points")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scheduleEventEnergies ScheduleEventEnergy[]

  @@map("energy_activity_catalogue")
}

model ScheduleEventEnergy {
  scheduleEventId     String @id @map("schedule_event_id") @db.Uuid
  activityCatalogueId String @map("activity_catalogue_id") @db.Uuid
  energyPoints        Int    @map("energy_points")
  constraintType      String @map("constraint_type") @db.Text
  energyMode          String @map("energy_mode") @db.Text
  confidence          Float

  scheduleEvent     ScheduleEvent           @relation(fields: [scheduleEventId], references: [id])
  activityCatalogue EnergyActivityCatalogue @relation(fields: [activityCatalogueId], references: [id])

  @@map("schedule_event_energy")
}

// Scheduling / Blocks

model BlockTemplate {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        BlockType @default(FOCUS)
  startTime   String    @map("start_time")
  endTime     String    @map("end_time")
  timezone    String?

  daysOfWeek        Int[]          @map("days_of_week")
  recurrenceType    RecurrenceType @default(WEEKLY) @map("recurrence_type")
  recurrencePattern Json?          @map("recurrence_pattern")

  defaultTaskId String? @map("default_task_id") @db.Uuid
  defaultTask   Task?   @relation(fields: [defaultTaskId], references: [id], onDelete: SetNull)

  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  blockInstances BlockInstance[]

  @@index([userId])
  @@map("block_template")
}

model BlockInstance {
  id         String         @id @default(uuid()) @db.Uuid
  templateId String?        @map("template_id") @db.Uuid
  template   BlockTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    DateTime @db.Date
  startAt DateTime @map("start_at") @db.Timestamptz(6)
  endAt   DateTime @map("end_at") @db.Timestamptz(6)

  durationMinutes Int         @map("duration_minutes")
  status          BlockStatus @default(SCHEDULED)

  title       String?
  description String?
  color       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // NEW: Link to unified ScheduleEvent
  scheduleEvent ScheduleEvent?

  @@index([userId, date])
  @@map("block_instance")
}

model UserSchedulePreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyCapacityMinutes Int? @map("weekly_capacity_minutes")
  dailyCapacityMinutes  Int? @map("daily_capacity_minutes")
  defaultFocusMinutes   Int? @default(60) @map("default_focus_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_schedule_preference")
}

// Newsletter subscriptions

model NewsletterSubscription {
  id    String @id @default(uuid()) @db.Uuid
  name  String @db.Text
  email String @unique @db.Text
  tasks String[] @db.Text

  beehiivSubscriptionId String? @map("beehiiv_subscription_id") @db.Text
  subscribedAt          DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  unsubscribedAt        DateTime? @map("unsubscribed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("newsletter_subscription")
}

model QuestionCard {
  id         String       @id @default(uuid()) @db.Uuid
  slug       String       @unique
  orderIndex Int          @map("order_index")

  title    String  // vd: "Capacity Reality"
  subtitle String? // vd: "Logical", "Pain Routing"
  question String  // vd: "What does a realistic week look like...?"

  type QuestionType // ENUM: SINGLE, MULTI, SLIDER, TEXT, NUMBER_INPUT

  options Json? @db.JsonB
  config  Json? @db.JsonB

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("question_card")
}

enum QuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  SLIDER
  TEXT_INPUT
  NUMBER_INPUT
}

enum SprintDifficulty {
  EASY
  NORMAL
  HARD
}

// Sprint Feedback

model SprintFeedback {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  sprintId   String?          @map("sprint_id") @db.Uuid
  difficulty SprintDifficulty
  slowdown   String?          @db.Text

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([sprintId])
  @@map("sprint_feedback")
}