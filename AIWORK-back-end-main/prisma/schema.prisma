generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum Role {
  USER
  ADMIN
}

enum SeniorityLevel {
  JUNIOR
  SENIOR
  LEAD_MANAGER
  OTHER
}

enum Priority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
  PRIORITY
}

enum TaskStatus {
  TODO
  DOING
  DONE
  URGENT
}

enum TaskType {
  NEWSPRINT
  BACKLOG
  STAGING
  ACTIVE
}

enum BlockType {
  FOCUS
  SERVICE
  BREAK
  MEETING
  PERSONAL
}

enum RecurrenceType {
  NONE
  WEEKLY
  CUSTOM
}

enum BlockStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum BrainDumpType {
  TASK_CANDIDATE
  DOCUMENT
  VOICE
}

enum BrainDumpStatus {
  QUEUED
  PENDING
  PROCESSING
  COMPLETED
  READING
  FAILED
}

enum AssetType {
  ATTACHMENT
  VOICE
}

enum AssetContext {
  TODO
}

enum SprintWindowType {
  TODAY
  WEEK
  BI_WEEKLY
  MONTHLY
  YEARLY
  THREEDAYS
}

enum SprintLane {
  LOW
  MEDIUM
  HIGH
  PRIORITY
}

enum TagType {
  TODO
}

enum TaskRunStatus {
  TODO
}

enum TaskRunStartedFrom {
  TODO
}

enum StepRunStatus {
  TODO
  DOING
  DONE
}

// ============================================================================
// COMPOSITE SCORING ENUMS
// ============================================================================

enum GoalTier {
  T1 // Operator's business goal (weight: 1.0)
  T2 // Client-specific goals (weight: 0.8)
  T3 // Additional goals (weight: 0.6)
}

enum ClientRevenueRange {
  UNDER_3K // score: 0.30
  K3_TO_7K // score: 0.55
  K7_TO_12K // score: 0.80
  K12_PLUS // score: 1.0
}

enum ClientRelationshipState {
  THRIVING // score: 1.0 → auto-maps to disposition: HAPPY
  STABLE // score: 0.70 → auto-maps to disposition: NEUTRAL
  UNDER_PRESSURE // score: 0.85 → auto-maps to disposition: ON_EDGE
  AT_RISK // score: 1.0 → auto-maps to disposition: HIGH_PRESSURE
}

enum ClientDisposition {
  HAPPY // multiplier: 1.0
  NEUTRAL // multiplier: 1.0
  ON_EDGE // multiplier: 1.15
  HIGH_PRESSURE // multiplier: 1.3
  WINDING_DOWN // multiplier: 0.7
}

enum ValueEnum {
  CLIENT_TRUST
  DEEP_WORK
  FAMILY
  HEALTH
  FINANCIAL_INDEPENDENCE
  STRATEGIC_IMPACT
  AUTONOMY
  CRAFT
}

// ============================================================================
// UPDATED ENUMS FOR UNIFIED SCHEDULE EVENTS
// ============================================================================

enum ScheduleEventSource {
  MANUAL
  SYNCED
  BLOCK_TEMPLATE  // NEW: From BlockInstance
  TASK_SESSION    // NEW: From TaskRun
  STEP_SESSION    // NEW: From StepRun
}

enum ScheduleEventProvider {
  GOOGLE
  APPLE
  OUTLOOK
  INTERNAL  // NEW: For system-generated events
}

enum ScheduleEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

// Core / Accounts

model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  password String?
  name     String
  role     Role?   @default(USER)

  // OAuth fields
  provider   String? // "google", "github", etc.
  providerId String? @map("provider_id") // OAuth provider user ID
  avatarUrl  String? @map("avatar_url")

  userProfile        UserProfile?
  tasks              Task[]
  blockTemplates     BlockTemplate[]
  blockInstances     BlockInstance[]
  schedulePreference UserSchedulePreference?

  brainDumps     BrainDump[]
  assets         Asset[]
  sprints        Sprint[]
  tags           Tag[]
  taskRuns       TaskRun[]
  scheduleEvents ScheduleEvent[]

  guidanceSessions GuidanceSession[]
  blockerLinks     BlockerLink[]
  sprintFeedbacks  SprintFeedback[]

  goals Goal[] @relation("GoalCreator")
  clients Client[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
}

model UserProfile {
  id     String    @id @default(uuid()) @db.Uuid
  dob    DateTime? @db.Date
  gender String

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String @map("job_id") @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id])

  projects Project[]

  // Composite scoring: top 3 values (ordered by drag-drop priority)
  valuesStack ValueEnum[] @map("values_stack")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_profile")
}

model Job {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  seniorityLevel SeniorityLevel @map("seniority_level")
  jobDescription String?        @map("job_description")

  seniorityOtherLabel String? @map("seniority_other_label")

  userProfiles UserProfile[]

  @@map("job")
}

model Project {
  id   String @id @default(uuid()) @db.Uuid
  name String

  roleInProject String?       @map("role_in_project")
  userProfiles  UserProfile[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("project")
}

// Goals (Composite Scoring)

model Goal {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tier               GoalTier
  rank               Int // drag-drop order (1-5+)
  title              String    @db.Text
  description        String?   @db.Text
  lastCompletionDate DateTime? @map("last_completion_date") @db.Timestamptz(6)

  user  User   @relation("GoalCreator", fields: [userId], references: [id])
  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, tier, rank])
  @@map("goal")
}

// Brain dumps + Assets

model BrainDump {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String?         @map("user_id") @db.Uuid
  type        BrainDumpType
  contextText String?         @map("context_text") @db.Text
  status      BrainDumpStatus @default(QUEUED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  attachments    BrainDumpAsset[]
  convertedTasks BrainDumpTask[]

  @@map("brain_dump")
}

model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         AssetType
  storagePath  String?   @map("storage_path") @db.Text
  url          String?   @db.Text
  title        String?   @db.Text
  metadataJson Json?     @map("metadata_json") @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  brainDumpLinks        BrainDumpAsset[]
  taskAssets            TaskAsset[]
  stepAssets            StepAsset[]
  guidanceSessionAssets GuidanceSessionAsset[]

  @@map("asset")
}

model BrainDumpAsset {
  brainDumpId String       @map("brain_dump_id") @db.Uuid
  assetId     String       @map("asset_id") @db.Uuid
  context     AssetContext
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  brainDump BrainDump @relation(fields: [brainDumpId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([brainDumpId, assetId])
  @@map("brain_dump_asset")
}

// BrainDump to Task join table (1:N - one brain dump can generate many tasks)

model BrainDumpTask {
  brainDumpId String   @map("brain_dump_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  orderIndex  Int?     @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  brainDump BrainDump @relation(fields: [brainDumpId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([brainDumpId, taskId])
  @@map("brain_dump_task")
}

// Tags

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  name           String   @db.Text
  type           TagType
  color          String?  @db.Text
  parentId       String?  @map("parent_id") @db.Uuid
  priorityWeight Float?   @map("priority_weight")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent   Tag?  @relation("TagHierarchy", fields: [parentId], references: [id])
  children Tag[] @relation("TagHierarchy")

  taskTags        TaskTag[]
  // sprintGoalLinks SprintGoalPriority[]
  tasks           Task[]

  @@map("tag")
}

// Clients / Tasks / Steps

model Client {
  id   String @id @default(uuid()) @db.Uuid
  name String

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite scoring: client weight dimension
  revenueRange      ClientRevenueRange?      @map("revenue_range")
  relationshipState ClientRelationshipState?  @map("relationship_state")
  disposition       ClientDisposition?        // Auto-mapped from relationshipState + editable
  clientWeight      Float?                    @map("client_weight") // Cached computed score

  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("client")
}

model Task {
  id          String @id @default(uuid()) @db.Uuid
  title       String @db.Text
  description String @db.Text

  expectedTimeHours Float? @map("expected_time_hours")
  extraProp         Json?  @map("extra_prop")
  scope             Json?  @map("scope") @db.JsonB
  status   TaskStatus @default(TODO)
  taskType TaskType   @default(STAGING) @map("task_type")
  priority Priority   @default(MEDIUM)
  rank     Int        @default(0)

  dueAt DateTime? @map("due_at") @db.Timestamptz(6)

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  goalId String? @map("goal_id") @db.Uuid
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Optional "primary tag" (legacy/simple)
  tagId String? @map("tag_id") @db.Uuid
  tag   Tag?    @relation(fields: [tagId], references: [id], onDelete: SetNull)

  // Active plan version
  activePlanVersionId String?          @map("active_plan_version_id") @db.Uuid
  activePlanVersion   TaskPlanVersion? @relation("TaskActivePlanVersion", fields: [activePlanVersionId], references: [id])

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  steps        Step[]
  planVersions TaskPlanVersion[]

  sprintItems      SprintItem[]
  taskTags         TaskTag[]
  taskRuns         TaskRun[]
  completionLogs   TaskCompletionLog[]
  sourceBrainDumps BrainDumpTask[]

  blockTemplates BlockTemplate[]
  taskAssets     TaskAsset[]

  planChangeProposals PlanChangeProposal[]

  blockerLinksAsBlocker     BlockerLink[] @relation("BlockerTask")
  blockerLinksAsBlockedTask BlockerLink[] @relation("BlockedTask")

  // Composite scoring fields (stored per-dimension + total)
  goalAlignment   Float?  @map("goal_alignment")    // 0-1.0
  clientWeightVal Float?  @map("client_weight_val")  // 0-1.0
  timeSensitivity Float?  @map("time_sensitivity")   // 0-1.0
  valuesAlignment Float?  @map("values_alignment")   // -0.3 to 1.0
  compositeScore  Float?  @map("composite_score")    // 0-100
  pinned          Boolean @default(false) @map("pinned")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([clientId])
  @@index([goalId])
  @@index([tagId])
  @@map("task")
}

model TaskPlanVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  taskId              String   @map("task_id") @db.Uuid
  createdBy           String   @map("created_by") @db.Text
  source              String   @db.Text
  scopeText           String   @map("scope_text") @db.Text
  successCriteriaText String   @map("success_criteria_text") @db.Text
  commonIssuesText    String   @map("common_issues_text") @db.Text
  researchSummaryText String   @map("research_summary_text") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id])

  steps             Step[]
  researchArtifacts ResearchArtifact[]

  activeForTasks Task[] @relation("TaskActivePlanVersion")

  planChangesFrom PlanChangeProposal[] @relation("PlanChangeFrom")
  planChangesTo   PlanChangeProposal[] @relation("PlanChangeTo")

  guidanceSessionResults GuidanceSession[] @relation("GuidanceSessionResultPlan")

  @@map("task_plan_version")
}

model Step {
  id             String  @id @default(uuid()) @db.Uuid
  taskId         String  @map("task_id") @db.Uuid
  planVersionId  String? @map("plan_version_id") @db.Uuid
  orderIndex     Int?    @map("order_index")
  title          String  @db.Text
  description    String? @db.Text
  sysEstMinutes  Float?  @map("sys_est_minutes")
  userEstMinutes Float?  @map("user_est_minutes")
  isDone         Boolean @default(false) @map("is_done")

  expectedTimeHours Float? @map("expected_time_hours")
  difficulty        Int?
  extraProp         Json?  @map("extra_prop")
  priority Priority   @default(MEDIUM)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  planVersion TaskPlanVersion? @relation(fields: [planVersionId], references: [id])

  stepRuns         StepRun[]
  activeInTaskRuns TaskRun[] @relation("ActiveStep")
  stepAssets       StepAsset[]

  blockerLinksAsBlockedStep BlockerLink[] @relation("BlockedStep")

  @@index([taskId])
  @@map("step")
}

model ResearchArtifact {
  id                String   @id @default(uuid()) @db.Uuid
  taskPlanVersionId String   @map("task_plan_version_id") @db.Uuid
  type              String   @db.Text
  title             String   @db.Text
  url               String   @db.Text
  content           String   @db.Text
  metadataJson      Json     @map("metadata_json") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taskPlanVersion TaskPlanVersion @relation(fields: [taskPlanVersionId], references: [id])

  @@map("research_artifact")
}

// Sprint planning

model Sprint {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  title           String?          @db.Text
  windowType      SprintWindowType @map("window_type")
  startDate       DateTime         @map("start_date") @db.Date
  endDate         DateTime         @map("end_date") @db.Date
  capacityMinutes Float?             @map("capacity_minutes")
  isActive        Boolean          @default(false) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items          SprintItem[]
  // goalPriorities SprintGoalPriority[]
  taskRuns       TaskRun[]
  feedbacks      SprintFeedback[]

  @@index([userId])
  @@map("sprint")
}

model SprintItem {
  id             String     @id @default(uuid()) @db.Uuid
  sprintId       String     @map("sprint_id") @db.Uuid
  taskId         String     @map("task_id") @db.Uuid
  lane           SprintLane
  rank           Int?
  plannedMinutes Float?       @map("planned_minutes")
  isBuffer       Boolean    @default(false) @map("is_buffer")
  isStarred      Boolean    @default(false) @map("is_starred")
  startNext      Boolean    @default(false) @map("start_next")
  addedMidSprint Boolean    @default(false) @map("added_mid_sprint")
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@index([taskId])
  @@map("sprint_item")
}

model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  contributionWeight Float?   @map("contribution_weight")
  isPrimary          Boolean  @default(false) @map("is_primary")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tag")
}

